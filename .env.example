# CollabCraft configuration. Copy to .env and fill in.
#
# Nothing here has a default that would work by accident. The service refuses
# to start without a secret, and warns loudly rather than pretending when an
# identity provider or a cloud provider is missing.

# ---- the shared secret ------------------------------------------------------
# Signs the join tokens the relay verifies. Both halves live in this one
# process, so this is the only place it appears.
#
# Generate one and keep it out of version control:
#   LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 48
#
# Rotating it invalidates every outstanding token, which is the intended way to
# revoke them all at once.
COLLABCRAFT_SECRET=

# ---- where this service is reached ------------------------------------------
# The public address, used for the OIDC redirect and handed to clients as the
# relay address. Not the bind address: a client elsewhere has to reach it.
COLLABCRAFT_PUBLIC_URL=https://collabcraft.example.com

# What the container publishes on the host. Keep it on the loopback when a
# reverse proxy terminates TLS in front, which is the usual arrangement.
COLLABCRAFT_LISTEN=127.0.0.1:9444

# ---- identity ---------------------------------------------------------------
# Any OIDC provider. Tested against Authentik and Keycloak.
#
# The issuer is the one whose /.well-known/openid-configuration resolves. For
# Authentik that includes the application slug.
#
# Register a confidential client with this redirect URI:
#   ${COLLABCRAFT_PUBLIC_URL}/auth/callback
# and the scopes openid, profile, email, groups. Entitlement is decided from
# group membership, so without the groups scope every user looks ungrouped.
COLLABCRAFT_OIDC_ISSUER=https://id.example.com/application/o/collabcraft/
COLLABCRAFT_OIDC_CLIENT_ID=
COLLABCRAFT_OIDC_CLIENT_SECRET=
COLLABCRAFT_OIDC_REDIRECT_URI=https://collabcraft.example.com/auth/callback

# ---- the cloud provider ------------------------------------------------------
# Where documents live. Three kinds: nextcloud, owncloud and webdav. The last is
# any server speaking WebDAV: SabreDAV, Apache, nginx, Seafile, a Synology or
# QNAP, ownCloud Infinite Scale, rclone. See *Providers* in the README.
#
# This is the default. A value saved on /settings/provider overrides it. That
# value lives on the bus with no expiry. A deployment that saves nothing keeps
# working exactly as it did.
COLLABCRAFT_PROVIDER_URL=https://cloud.example.com

# Which implementation answers at that address. Unset means nextcloud.
#
#   nextcloud  the server root. Users link through Nextcloud's own sign-in.
#   owncloud   the server root. Users link with a login name and app password.
#   webdav     the files address itself, with {user} where the login name goes,
#              e.g. https://dav.example.com/remote.php/dav/files/{user}
#              Users link with a login name and an app password or token.
#   git        a GitHub / Gitea / Forgejo repository URL, owner/repo.
#              Users link with a login name and a personal access token.
# COLLABCRAFT_PROVIDER_KIND=nextcloud

# webdav only, optional: a CardDAV address-book home for the contact picker,
# with {user} as above. The other kinds find their own address books.
# COLLABCRAFT_PROVIDER_CONTACTS_URL=https://dav.example.com/addressbooks/{user}

# ---- who may change the provider from a browser ------------------------------
# Groups from the identity provider whose members may open /settings/provider
# and point this deployment at a different cloud. Comma separated.
#
# Saving tests the address first. One that does not answer is never saved.
#
# A deployment that names no group here has nobody who may change it. The page
# then refuses everybody. Set this to a group you control before relying on it.
COLLABCRAFT_ADMIN_GROUPS=

# ---- the bus -----------------------------------------------------------------
# Any Redis-compatible server. Holds the per-document sequence, the scope locks
# and the sessions, all with expiry.
#
# It must not evict. The sequence counters are not a cache, and losing one
# silently reorders every edit in that document.
COLLABCRAFT_VALKEY_URL=redis://valkey:6379/6

# ---- entitlement -------------------------------------------------------------
# Which apps a user may open. The default applies to everyone who signs in.
# Add COLLABCRAFT_APPS_<GROUP> to grant more to a group from the identity
# provider, upper-cased, for example COLLABCRAFT_APPS_EDITORS.
#
# This is the default. A member of COLLABCRAFT_ADMIN_GROUPS can change it at
# /settings/apps without a redeploy, and what they save here overrides it.
COLLABCRAFT_APPS_DEFAULT=gridcraft,wordcraft,deckcraft

# ---- the browser builds ------------------------------------------------------
# A directory of per-app WebAssembly builds, one directory per app, served
# behind the same permission check. Leave COLLABCRAFT_WEB_DIR pointing at an
# empty directory to run as an API and relay only.
#
# Serve them precompressed: put foo.wasm.br beside foo.wasm and the service
# sends it with the right Content-Encoding. Brotli at a high level costs
# minutes per bundle, which is unaffordable per request and free once.
COLLABCRAFT_WEB_DIR=./web

# ---- sharing with somebody who has no account --------------------------------
# A share aimed at an address the provider holds no account for produces a link
# carrying a one-time key. The provider is asked to mail that. Set this to `off`
# where an organisation forbids such links. Nothing is then minted. Every link
# answers 404. The share dialog is told the capability is absent. No button
# therefore appears.
#
# The link points at COLLABCRAFT_PUBLIC_URL. A deployment that does not set that
# mints nothing either.
# COLLABCRAFT_KEYED_LINKS=off

# How long one of those links lasts, in hours. A week by default, capped at 30
# days. Long enough for somebody who reads mail on Monday to open the document
# on Friday. Short enough that a forwarded link stops working.
# COLLABCRAFT_KEYED_LINK_TTL_HOURS=168

# How many times one may be opened. Once by default, capped at 50. A keyed link
# is addressed to one person. The second use of it is somebody that person
# forwarded it to.
# COLLABCRAFT_KEYED_LINK_USES=1

# ---- certificates ------------------------------------------------------------
# Only needed where the identity provider or the cloud provider is behind a CA
# the base image does not ship, which is common on an internal deployment.
# Mount a bundle carrying the public roots alongside your own, and point this
# at it. Replacing the system bundle with only your CA breaks every public call.
# COLLABCRAFT_CA_BUNDLE=/etc/ssl/collabcraft/ca-bundle.pem

# ---- e-sign ------------------------------------------------------------------
# Durable envelope store. Unset disables /api/v1/esign entirely.
# COLLABCRAFT_ESIGN_DATABASE_URL=postgres://collabcraft:collabcraft@esign-db:5432/esign
#
# stub (default) or documenso
# COLLABCRAFT_ESIGN_PROVIDER=stub
#
# Documenso (when provider=documenso). Secrets via vault/OpenBao in the lab.
# COLLABCRAFT_DOCUMENSO_URL=http://documenso:3000
# COLLABCRAFT_DOCUMENSO_API_TOKEN=
# COLLABCRAFT_DOCUMENSO_WEBHOOK_SECRET=

# ---- image -------------------------------------------------------------------
# COLLABCRAFT_IMAGE=ghcr.io/storytold/collab-craft:latest
